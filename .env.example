# Configurações da API Amadeus (obrigatório)
AMADEUS_KEY=your_amadeus_api_key_here
AMADEUS_SECRET=your_amadeus_api_secret_here

# Configurações do Telegram (opcional - para notificações e controle por bot)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here
TG_ALLOWED_IDS=user_id1,user_id2,user_id3

# Configurações de teste (opcional - para testes manuais)
ORIGIN=GRU
DEST=JFK